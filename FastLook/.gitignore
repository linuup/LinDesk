# ============================================================
#  FastLook — .gitignore
# ============================================================

# ── 构建输出目录 ─────────────────────────────────────────────
build-nuitka/
build-pyinstaller/

# Nuitka 中间产物（.dist / .build 临时目录）
*.dist/
*.build/
main.dist/
main.build/

# PyInstaller spec 文件（自动生成，无需纳入版本控制）
*.spec

# ── Python 缓存 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── 虚拟环境 ─────────────────────────────────────────────────
.venv/
venv/
env/
Env/

# ── 打包产物 ─────────────────────────────────────────────────
dist/
*.exe
*.pyd
*.so

# ── 编辑器 / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ── 系统文件 ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# ── 日志 & 临时文件 ──────────────────────────────────────────
*.log
*.tmp
*.bak
