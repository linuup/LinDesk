{
  "id": "lindesk.wallpaper",
  "name": "LinDesk Living Wallpaper 流体极光",
  "version": "1.1.0",
  "author": "LinDesk",
  "description": "官方交互式动态壁纸：流体极光、宇宙引力奇点与量子网格，支持桌面鼠标物理波动。",
  "role": "wallpaper",
  "type": "html",
  "entry": "index.html",
  "interactive": true,
  "permissions": [
    "storage",
    "desktop"
  ],
  "properties": {
    "particleCount": {
      "type": "slider",
      "text": "量子粒子密度",
      "min": 50,
      "max": 600,
      "step": 25,
      "value": 240
    },
    "fluidSpeed": {
      "type": "slider",
      "text": "流体极光流速",
      "min": 1,
      "max": 8,
      "step": 1,
      "value": 3
    },
    "singularityColor": {
      "type": "color",
      "text": "引力奇点主色调",
      "value": "#6366f1"
    },
    "reactiveMouseWave": {
      "type": "boolean",
      "text": "鼠标引力波动感知",
      "value": true
    }
  }
}
