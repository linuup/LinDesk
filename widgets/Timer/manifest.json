{
  "id": "lindesk.timer",
  "name": "Timer",
  "version": "1.1.0",
  "author": "LinDesk",
  "description": "Minimal countdown and Pomodoro focus timer with ring progress.",
  "main": "index.html",
  "entry": "index.html",
  "icon": "icon.png",
  "minWidth": 160,
  "minHeight": 100,
  "width": 220,
  "height": 240,
  "type": "html",
  "transparent": true,
  "resizable": true,
  "permissions": [
    "storage"
  ],
  "settingsSchema": [
    {
      "key": "theme",
      "type": "select",
      "title": "主题模式",
      "description": "切换深色或浅色外观",
      "default": "dark",
      "options": [
        { "label": "暗夜深邃 (Dark)", "value": "dark" },
        { "label": "极简浅色 (Light)", "value": "light" }
      ]
    },
    {
      "key": "defaultDuration",
      "type": "select",
      "title": "默认计时时长",
      "description": "初始化或重置时的计时分钟数",
      "default": 300,
      "options": [
        { "label": "1 分钟", "value": 60 },
        { "label": "3 分钟", "value": 180 },
        { "label": "5 分钟 (默认)", "value": 300 },
        { "label": "10 分钟", "value": 600 },
        { "label": "25 分钟 (番茄钟)", "value": 1500 },
        { "label": "60 分钟", "value": 3600 }
      ]
    }
  ]
}