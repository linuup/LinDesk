{
  "id": "lindesk.todo",
  "name": "Todo",
  "version": "1.0.0",
  "author": "LinDesk",
  "description": "A bundled transparent Todo widget for the LinDesk desktop.",
  "width": 300,
  "height": 400,
  "minWidth": 200,
  "minHeight": 250,
  "maxWidth": 500,
  "maxHeight": 800,
  "autoLoad": true,
  "type": "html",
  "transparent": true,
  "resizable": true,
  "entry": "index.html",
  "settings": "settings.html",
  "permissions": [
    "storage"
  ]
}
